# Copy to .env and fill in. Never commit .env.
MODE=replay                 # replay | live

# Gnani (P)
GNANI_API_KEY=              # TTS key (app.gnani.ai/voice)
INYA_API_KEY=               # Inya platform key: agents + conversations permissions
GNANI_AGENT_ID=
CLINIC_PHONE=+91

# Pine Labs UAT (K)
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MID=
PINELABS_BASE=https://pluraluat.v2.pinepg.in

# Delhivery (K, optional)
DELHIVERY_TOKEN=

# Hugging Face (P)
HF_TOKEN=

# Twilio WhatsApp sandbox (P)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+1                # Twilio WhatsApp number shown in Try out WhatsApp
CAREGIVER_WHATSAPP=+91              # Pursharth's phone, joined to the sandbox
PUBLIC_URL=                         # ngrok https URL; media is served from <PUBLIC_URL>/data/...
WA_PORT=8787
