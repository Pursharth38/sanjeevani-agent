# Copy to .env and fill in. Never commit .env.
MODE=replay                 # replay | live

# Gnani (P)
GNANI_API_KEY=
GNANI_AGENT_ID=
CLINIC_PHONE=+91

# Pine Labs UAT (K)
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MID=
PINELABS_BASE=https://pluraluat.v2.pinepg.in
PINELABS_WEBHOOK_SECRET=    # Dashboard → Settings → Webhooks (base64); verifies ORDER_PROCESSED
PINELABS_PAYMENT=simulated  # simulated = real UAT order + simulated payment; checkout = real Hosted Checkout payment
PINELABS_OPEN_CHECKOUT=0    # 1 = open the Pine Labs checkout page in the browser automatically (macOS)
PUBLIC_URL=                 # ngrok https URL; webhooks go to $PUBLIC_URL/webhooks/<module>

# Delhivery (K, optional)
DELHIVERY_TOKEN=

# Hugging Face (P)
HF_TOKEN=

# Orchestrator (K)
PORT=4000
PREROLL=1                   # 0 = start at the trigger
HOLD_WINDOW_S=10            # the 10-minute HOLD window, compressed for the demo
