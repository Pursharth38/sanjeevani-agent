# Copy to .env and fill in. Never commit .env.
MODE=replay                 # replay | live

# Gnani (P)
GNANI_API_KEY=              # TTS key (app.gnani.ai/voice)
INYA_API_KEY=               # Inya platform key: agents + conversations permissions
GNANI_AGENT_ID=
CLINIC_PHONE=+91

# Pine Labs UAT (K)
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MID=
PINELABS_BASE=https://pluraluat.v2.pinepg.in
PINELABS_WEBHOOK_SECRET=    # Dashboard → Settings → Webhooks (base64); verifies ORDER_PROCESSED
PINELABS_PAYMENT=simulated  # simulated = real UAT order + our simulated payment window; checkout = real Hosted Checkout payment
PAY_AUTO_S=5                # payment window auto-confirms after this many seconds; PAY_AUTO=0 waits for a click
PINELABS_OPEN_CHECKOUT=0    # 1 = open the Pine Labs checkout page in the browser automatically (macOS)
PUBLIC_URL=                 # only for PINELABS_PAYMENT=checkout: ngrok https URL for the Pine Labs webhook/callback

# Delhivery (K, optional)
DELHIVERY_TOKEN=             # without it, serviceability is SIMULATED (the pincode check stays real)
DELHIVERY_BASE=              # optional; default https://track.delhivery.com (staging: https://staging-express.delhivery.com)

# Hugging Face (P)
HF_TOKEN=

# Orchestrator (K)
PORT=4000
PREROLL=1                   # 0 = start at the trigger
HOLD_WINDOW_S=10            # the 10-minute HOLD window, compressed for the demo

# Twilio WhatsApp (P, parked: WA_MODE=twilio only; the trial account can't send free text)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+1
CAREGIVER_WHATSAPP=+91
WA_PORT=8787
